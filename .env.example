# ZK_PREVIEW unset/1 = landing + docs only (no keys needed). Set 0 to run the game.
ZK_PREVIEW=1
# Network: mainnet | devnet | localnet
ZK_CLUSTER=devnet
# Server-side RPC (may contain an API key; never sent to browsers — they use /api/rpc)
ZK_RPC=
ZK_NETWORK_LABEL=
ZK_PROGRAM_ID=
# Host signer (base58 or JSON array). Opens days/rounds, co-signs seats, reveals. Keep it funded with a little SOL only.
ZK_HOST_KEY=
ZK_TREASURY=FuRUWehSQyB8EaMy5t8SRmYhKZEc8cBpYWBXripikXW6
ZK_FEE_BPS=500
ZK_DB=/var/data/zkdle.db
# Bounty rounds are paid in $PROOF: the entry is the $PROOF worth ZK_ROUND_ENTRY_SOL, fixed once per round from a short TWAP
ZK_ROUND_ENTRY_SOL=0.01
# used when no price is available (e.g. right after launch); clamps in whole tokens, 0 = off
ZK_ROUND_ENTRY_TOKENS=1000
ZK_ROUND_ENTRY_MIN_TOKENS=0
ZK_ROUND_ENTRY_MAX_TOKENS=0
ZK_ROUND_BURN_BPS=1000
# early access: the program allows at most 12 seats per round
ZK_ROUND_CAP=12
ZK_JOIN_CUTOFF_SECS=120
# price: pump.fun bonding curve is read automatically; after graduation set the pool's two reserve accounts "<token vault>,<wSOL vault>"
ZK_PRICE_POOL_VAULTS=
ZK_PRICE_SAMPLE_SECS=60
ZK_PRICE_WINDOW_SECS=300
ZK_PRICE_MIN_SAMPLES=3
# prover: proofs are single-threaded and queued; above the queue limit the API answers 429 and clients retry
ZK_PROVE_CONCURRENCY=1
ZK_PROVE_QUEUE_MAX=30
ZK_ROUND_SECS=3600
ZK_DUEL_SECS=86400
# Token (leave mint empty until launch; the site shows it automatically once set)
ZK_TOKEN_MINT=
ZK_TOKEN_SYMBOL=PROOF
ZK_TOKEN_NAME=ZKdle Proof
ZK_TOKEN_DECIMALS=6
# holder perk: gold frame + holder badge on share cards
ZK_HOLDER_MIN=100000
ZK_MEND_TOKENS=500
ZK_BASE_URL=
ZK_X_URL=https://x.com/zkdle
ZK_GITHUB_URL=https://github.com/zkdle

# security
ZK_SECRET_KEY=            # 32 bytes hex/base64, encrypts the state file; required outside localnet (openssl rand -hex 32)
ZK_MAX_POT_SOL_EQUIV=5     # refuse seats once a round's escrow would exceed this
ZK_WALLET_PER_MIN=20
