{
  "name": "zkdle",
  "version": "0.1.0",
  "description": "A daily five-letter word on Solana. Every clue carries a Groth16 proof checked on-chain.",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build.js && node scripts/brand.js",
    "build:program": "cd program && cargo-build-sbf",
    "build:circuit": "circom2 circuits/clue.circom --r1cs --wasm -l node_modules -o zk && node scripts/vk2rs.js",
    "start": "node server.js",
    "localnet": "node scripts/localnet.js",
    "e2e": "node scripts/e2e.js",
    "shots": "node scripts/shots.js",
    "e2e:ui": "node scripts/ui-e2e.js"
  },
  "keywords": [
    "solana",
    "zk",
    "groth16",
    "word-game",
    "circom",
    "blinks"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "compression": "^1.8.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@solana/spl-token": "^0.4.15",
    "puppeteer-core": "^24.43.1"
  },
  "homepage": "https://zkdle.fun",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "rpc-websockets": {
      "ws": "^8.22.0"
    },
    "@ethersproject/providers": {
      "ws": "^8.22.0"
    },
    "isomorphic-ws": {
      "ws": "^8.22.0"
    }
  }
}
